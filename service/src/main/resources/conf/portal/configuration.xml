<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
               xsi:schemaLocation="http://www.exoplatform.org/xml/ns/kernel_1_2.xsd http://www.exoplatform.org/xml/ns/kernel_1_2.xsd"
               xmlns="http://www.exoplatform.org/xml/ns/kernel_1_2.xsd">
  <component>
    <key>SamlLoginParamsExtension</key>
    <type>org.exoplatform.addons.saml.extensions.SamlLoginParamsExtension</type>
    <init-params>
      <value-param>
        <name>enabled</name>
        <value>${gatein.sso.saml.login.page.enabled:false}</value>
      </value-param>
    </init-params>
  </component>
  <external-component-plugins>
    <target-component>org.gatein.sso.integration.SSOFilterIntegrator</target-component>
    <component-plugin>
      <name>SamlEnforcedLoginFilter</name>
      <set-method>addPlugin</set-method>
      <type>org.gatein.sso.integration.SSOFilterIntegratorPlugin</type>
      <init-params>
        <value-param>
          <name>filterClass</name>
          <value>org.exoplatform.addons.saml.extensions.SamlEnforcedLoginFilter</value>
        </value-param>
        <value-param>
          <name>enabled</name>
          <value>${gatein.sso.saml.login.page.enabled:false}</value>
        </value-param>
        <value-param>
          <name>filterMapping</name>
          <!-- Every request: the filter only acts on the anonymous ones of the enforced clients (login routes and remember-me cookie) -->
          <value>/*</value>
        </value-param>
        <value-param>
          <name>ENFORCED_IPS</name>
          <value>${gatein.sso.saml.login.enforced.ips:}</value>
        </value-param>
        <value-param>
          <name>SSO_URL_SUFFIX</name>
          <value>${gatein.sso.uri.suffix:/sso}</value>
        </value-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>
  <external-component-plugins>
    <target-component>org.exoplatform.services.cache.CacheService</target-component>
    <component-plugin>
      <name>addExoCacheConfig</name>
      <set-method>addExoCacheConfig</set-method>
      <type>org.exoplatform.services.cache.ExoCacheConfigPlugin</type>
      <description>The pages asked for before the SAML sign-in, kept under the RelayState of the request to the IDP</description>
      <init-params>
        <object-param>
          <name>saml.relaystate</name>
          <description>The cache configuration for the pages asked for before the SAML sign-in</description>
          <object type="org.exoplatform.services.cache.impl.infinispan.generic.GenericExoCacheConfig">
            <field name="name"><string>saml.relaystate</string></field>
            <field name="strategy" profiles="cluster"><string>${exo.cache.saml.relaystate.strategy:LIRS}</string></field>
            <field name="maxSize"><int>${exo.cache.saml.relaystate.MaxNodes:10000}</int></field>
            <field name="liveTime"><long>${exo.cache.saml.relaystate.TimeToLive:600}</long></field>
            <field name="cacheMode" profiles="cluster"><string>${exo.cache.saml.relaystate.cacheMode:replication}</string></field>
          </object>
        </object-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>
</configuration>
